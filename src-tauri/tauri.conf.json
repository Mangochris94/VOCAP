{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocap",
  "version": "0.2.0",
  "identifier": "com.cuppathai.vocap",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Vocap",
        "width": 460,
        "height": 620,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "center": false,
        "x": 40,
        "y": 40,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "A calm word-discovery companion",
    "longDescription": "Letters drop slowly while you work. Mine them for words, learn what they mean."
  }
}
